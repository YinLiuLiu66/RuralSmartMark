# 运行环境：development | production
APP_ENV=development
DEBUG=true

# 监听地址
HOST=127.0.0.1
PORT=8000

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI 兼容接口配置
OPENAI_API_KEY=
# 使用兼容网关时填写，例如 https://api.deepseek.com/v1
OPENAI_BASE_URL=
# 文本模型 id（SiliconFlow 命名，decisions #23）
OPENAI_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# 数据库（docker compose 起的 PG18，见根目录 docker-compose.yml）
DATABASE_URL=postgresql+asyncpg://postgres:rsm_demo_2026@127.0.0.1:5432/ruralsmartmark

# JWT 鉴权（演示密钥，生产必须换掉；HS256 建议 ≥32 字符）
JWT_SECRET=dev-secret-0123456789abcdef0123456789abcdef
JWT_EXPIRE_HOURS=12

# 模拟引擎随机种子（留空 = 每次随机；演示剧本填固定值 7）
SIM_SEED=7
