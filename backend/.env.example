APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_THINKING_BUDGET=2048
LLM_MAX_TOKENS=4096
# 图像模型：Tongyi-MAI/Z-Image-Turbo（快、约 ¥0.1/张）或 Tongyi-MAI/Z-Image（全量）
# 接口：POST {IMAGE_BASE_URL}/images/generations；IMAGE_BASE_URL 空=复用 OPENAI_BASE_URL
IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
IMAGE_BASE_URL=
IMAGE_SIZE=
IMAGE_NEGATIVE_PROMPT=真实人物肖像, 照片, 品牌logo, 低清晰度
IMAGE_TIMEOUT_SECONDS=120
PUBLIC_BASE_URL=http://127.0.0.1:5173
AUTO_APPROVE=false
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_SECONDS=180

# 总控调研：Firecrawl 搜索/抓页；key 不要提交
SEARCH_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_MAX_SCRAPES=4
SEARCH_TIMEOUT_SECONDS=60
CONTROLLER_REQUEST_LIMIT=10
CONTROLLER_TOOL_CALLS_LIMIT=12
RESEARCH_REQUEST_LIMIT=8
RESEARCH_TOOL_CALLS_LIMIT=10
RESEARCH_MAX_TOKENS=8192
